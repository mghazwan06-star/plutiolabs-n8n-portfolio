          "jsCode": "try {\n  var trigger = $('Execute Workflow Trigger').first().json;\n  var phone = trigger.phone || '';\n  var toolUseId = trigger.toolUseId || '';\n  var toolInput = trigger.toolInput || {};\n  var reason = toolInput.reason || '';\n\n  var rows = $input.all();\n  var found = null;\n\n  for (var i = 0; i < rows.length; i++) {\n    var row = rows[i].json;\n    if (String(row.Phone).replace(/[^0-9]/g, '') === String(phone).replace(/[^0-9]/g, '') && row.Status === 'confirmed') {\n      found = row;\n      break;\n    }\n  }\n\n  if (found) {\n    return [{\n      json: {\n        hasAppointment: true,\n        calendarEventId: found.CalendarEventId || '',\n        phone: phone,\n        toolUseId: toolUseId,\n        reason: reason,\n        appointmentDate: found.Date || '',\n        appointmentTime: found.Time || ''\n      }\n    }];\n  } else {\n    return [{\n      json: {\n        hasAppointment: false,\n        phone: phone,\n        toolUseId: toolUseId,\n        calendarEventId: '',\n        reason: reason\n      }\n    }];\n  }\n} catch (e) {\n  var fb = $('Execute Workflow Trigger').first().json;\n  return [{\n    json: {\n      hasAppointment: false,\n      phone: fb.phone || '',\n      toolUseId: fb.toolUseId || '',\n      calendarEventId: '',\n      error: e.message\n    }\n  }];\n}"
        },
        "onError": "continueRegularOutput"
