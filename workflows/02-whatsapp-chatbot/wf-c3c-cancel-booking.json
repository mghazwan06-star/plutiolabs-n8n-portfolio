    {
      "id": "success-c3c",
      "name": "Build Cancel Success",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2220,
        180
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "try {\n  var appt = $('Find Confirmed Appointment').first().json;\n  var date = appt.appointmentDate || '';\n  var time = appt.appointmentTime || '';\n  var toolUseId = appt.toolUseId || '';\n\n  var when = date ? (' on ' + date + (time ? ' at ' + time : '')) : '';\n  var result = 'Your appointment' + when + ' has been successfully cancelled. If you change your mind, feel free to book again anytime.';\n\n  return [{\n    json: {\n      toolCallId: toolUseId,\n      result: result\n    }\n  }];\n} catch (e) {\n  return [{\n    json: {\n      toolCallId: $('Find Confirmed Appointment').first().json.toolUseId || '',\n      result: 'Your appointment has been successfully cancelled.'\n    }\n  }];\n}"
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "no-booking-c3c",
      "name": "Build No Booking Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1500,
        440
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "try {\n  return [{\n    json: {\n      toolCallId: $json.toolUseId || '',\n      result: \"I couldn't find an active booking associated with your number. If you believe this is an error, please contact us directly.\"\n    }\n  }];\n} catch (e) {\n  return [{\n    json: {\n      toolCallId: '',\n      result: \"I couldn't find an active booking for your number.\"\n    }\n  }];\n}"
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "del-fail-c3c",
      "name": "Build Delete Failed Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1940,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "try {\n  var appt = $('Find Confirmed Appointment').first().json;\n  var config = $('⚙️ Client Config').first().json;\n  var phone = config.businessPhone || '';\n  var phoneValid = phone && phone !== 'ADD_PHONE_BEFORE_ACTIVATION';\n  var phoneMsg = phoneValid ? ' Please call us on ' + phone + ' and we will sort it out.' : ' Please contact us directly to resolve this.';\n  var result = 'There was a problem removing your appointment from our calendar.' + phoneMsg + ' Your booking has not been marked as cancelled in our system.';\n  return [{ json: { toolCallId: appt.toolUseId || '', result: result } }];\n} catch (e) {\n  return [{ json: { toolCallId: '', result: 'There was a system error cancelling your appointment. Please contact us directly.' } }];\n}"
      },
      "onError": "continueRegularOutput"
    }
