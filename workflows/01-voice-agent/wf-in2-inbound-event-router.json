    {
      "parameters": {
        "jsCode": "try {\n  var result = $input.first().json;\n  if (result && result.variables) {\n    return [{ json: result }];\n  }\n  // WF8 returned no variables — return empty (call proceeds with generic greeting)\n  return [{ json: { variables: {} } }];\n} catch(e) {\n  return [{ json: { variables: {} } }];\n}"
      },
