      "id": "win2-call-wf3",
      "name": "Call WF3 Tool Dispatcher",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        672,
        272
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "try {\n  var wf3Result = $input.first().json;\n  if (wf3Result && wf3Result.results && Array.isArray(wf3Result.results) && wf3Result.results.length > 0) {\n    return [{ json: wf3Result }];\n  }\n  // WF3 failed — build graceful fallback using original toolCallIds\n  var fallbackMsg = $('⚙️ Client Config').first().json.toolErrorMessage || \"I'm having a technical issue. Please try again.\";\n  var results = [];\n  try {\n    var msg = $('VAPI Inbound Webhook').first().json.body.message;\n    if (msg && msg.toolCallList && msg.toolCallList.length > 0) {\n      var i;\n      for (i = 0; i < msg.toolCallList.length; i++) {\n        results.push({ toolCallId: msg.toolCallList[i].id, result: fallbackMsg });\n      }\n    }\n  } catch(e2) {}\n  if (results.length === 0) {\n    results.push({ toolCallId: 'unknown', result: fallbackMsg });\n  }\n  return [{ json: { results: results } }];\n} catch(e) {\n  return [{ json: { results: [{ toolCallId: 'unknown', result: 'An error occurred. Please try again.' }] } }];\n}"
      },
