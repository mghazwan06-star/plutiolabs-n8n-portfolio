      "typeVersion": 1.5,
      "position": [
        1200,
        80
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "content": "**End-of-Call Branch**\n\nFires WF4 asynchronously — does NOT wait.\nResponds 200 OK to VAPI immediately.\n\nWF4 handles: CRM update, Clients tab update,\nSMS confirmation, urgency alerts.\n\n⚠️ Update wf4Id in Client Config when WF4 is built.",
        "height": 260,
        "width": 300,
        "color": 5
      },
      "id": "sticky-eoc",
      "name": "📊 End-of-Call Branch",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1376,
        256
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
