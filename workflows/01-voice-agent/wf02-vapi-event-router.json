    },
    {
      "parameters": {
        "jsCode": "// Check if WF3 returned valid results or if it errored\nvar inputData = $input.first().json;\nvar fallbackMsg = $('⚙️ Client Config').first().json.toolErrorMessage || \"I'm having a technical issue. Someone from our team will call you back shortly.\";\n\n// Success path: WF3 returned results array\nif (inputData.results && Array.isArray(inputData.results) && inputData.results.length > 0) {\n  return [{ json: inputData }];\n}\n\n// Error path: WF3 crashed or returned empty — build graceful VAPI fallback\nvar results = [];\ntry {\n  var msg = $('VAPI Webhook').first().json.body.message;\n  if (msg && msg.toolCallList && msg.toolCallList.length > 0) {\n    var i;\n    for (i = 0; i < msg.toolCallList.length; i++) {\n      results.push({\n        toolCallId: msg.toolCallList[i].id,\n        result: fallbackMsg\n      });\n    }\n  }\n} catch(e) {}\n\nif (results.length === 0) {\n  results.push({\n    toolCallId: \"unknown\",\n    result: fallbackMsg\n  });\n}\n\nreturn [{ json: { results: results } }];"
      },
      "id": "wf2-wf3-handler",
      "name": "Handle WF3 Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        80
      ],
      "onError": "continueRegularOutput"
    }
  ],
