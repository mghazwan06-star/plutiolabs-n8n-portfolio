        },
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "wf2-call-wf3",
      "name": "Call WF3 Tool Dispatcher",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        720,
        80
      ],
      "onError": "continueRegularOutput"
    },
