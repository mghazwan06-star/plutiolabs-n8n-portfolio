    {
      "id": "wf5-classify",
      "name": "Filter & Classify Leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        740,
        460
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "try {\n  var items = $input.all();\n  var now = new Date();\n  var results = [];\n  var month = now.getUTCMonth() + 1;\n  var tzOffset = (month >= 3 && month <= 10) ? 1 : 0;\n  var localHour = (now.getUTCHours() + tzOffset) % 24;\n  var isBusinessHours = (localHour >= 8 && localHour < 21);\n  for (var i = 0; i < items.length; i++) {\n    var lead = items[i].json;\n    var phone = (lead['Phone'] || '').toString().trim();\n    if (!phone) { continue; }\n    var status = (lead['Status'] || '').toString().trim();\n    var seqStep = parseInt((lead['Sequence Step'] || '0').toString(), 10);\n    if (isNaN(seqStep)) { seqStep = 0; }\n    var smsOptOut = (lead['SMS Opt-Out'] || 'N').toString().trim().toUpperCase();\n    var lastContact = (lead['Last Contact'] || '').toString().trim();\n    var seqStartedAt = (lead['Sequence Started At'] || '').toString().trim();\n    var callbackTime = (lead['Callback Time'] || '').toString().trim();\n    var name = (lead['Name'] || 'there').toString().trim();\n    var serviceInterest = (lead['Service Interest'] || 'home improvement').toString().trim();\n    var callAttempts = parseInt((lead['Call Attempt Count'] || '0').toString(), 10);\n    if (isNaN(callAttempts)) { callAttempts = 0; }\n    var action = null;\n    if (status === 'booked' || status === 'not-interested' || status === 'do-not-contact' || status === 'unresponsive') { continue; }\n    if (!action && isBusinessHours && status === 'new' && seqStep === 0 && !lastContact && callAttempts < 5) { action = 'fire-call-1'; }\n    if (!action && isBusinessHours && status === 'callback-scheduled' && callbackTime) {\n      var cbDate = new Date(callbackTime);\n      if (!isNaN(cbDate.getTime()) && now.getTime() >= cbDate.getTime()) { action = 'fire-callback'; }\n    }\n    if (!action && isBusinessHours && seqStep === 0 && (status === 'no-answer' || status === 'voicemail')) {\n      if (seqStartedAt) { var seqStart = new Date(seqStartedAt); if (!isNaN(seqStart.getTime())) { var minsSince = (now.getTime() - seqStart.getTime()) / 60000; if (minsSince >= 30) { action = 'fire-call-2'; } } }\n    }\n    if (!action && isBusinessHours && seqStep === 1 && status === 'sequence-active') {\n      if (smsOptOut === 'Y') { continue; }\n      if (lastContact) { var lc1 = new Date(lastContact); if (!isNaN(lc1.getTime())) { var h1 = (now.getTime() - lc1.getTime()) / 3600000; if (h1 >= 4) { action = 'send-sms-2'; } } }\n    }\n    if (!action && seqStep === 2 && status === 'sequence-active') {\n      if (lastContact) { var lc2 = new Date(lastContact); if (!isNaN(lc2.getTime())) { var h2 = (now.getTime() - lc2.getTime()) / 3600000; if (h2 >= 24 && isBusinessHours) { action = 'fire-call-3'; } } }\n    }\n    if (!action && seqStep === 3 && status === 'sequence-active') {\n      if (lastContact) { var lc3 = new Date(lastContact); if (!isNaN(lc3.getTime())) { var h3 = (now.getTime() - lc3.getTime()) / 3600000; if (h3 >= 2) { action = 'mark-unresponsive'; } } }\n    }\n    if (action) { results.push({ json: { phone: phone, name: name, serviceInterest: serviceInterest, status: status, seqStep: seqStep, action: action, callbackTime: callbackTime, lastContact: lastContact, callAttempts: callAttempts } }); }\n  }\n  return results;\n} catch(e) { throw new Error('WF5 classify error: ' + e.message); }"
      },
      "onError": "continueRegularOutput"
    },
