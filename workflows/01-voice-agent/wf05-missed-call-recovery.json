  "nodes": [
    {
      "id": "wf5-sticky-overview",
      "name": "WF5 Overview",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        60,
        80
      ],
      "parameters": {
        "content": "## WF5 — Missed Call Recovery\n\nPolls every 30 min. Finds leads that did not answer and works them through the retry sequence.\n\n**Sequence logic:**\n- Step 0 + no-answer/voicemail: wait 30 min, then Call #2\n- Step 1 + sequence-active: wait 4h, then SMS Follow-up\n- Step 2 + sequence-active: wait 24h, then Call #3\n- Step 3 + sequence-active: wait 2h grace, then Mark Unresponsive\n\n**Callback branch:** Fires VAPI when Callback Time is reached.\n**Business hours:** Calls and SMS only fire 08:00-20:59 London time.\n**Error alerts:** Owner SMS alert if VAPI call fails to queue.\n\nActivate AFTER WF3, WF4, WF2, WF1 are active.",
        "color": 4,
        "width": 600,
        "height": 340
      }
    },
    {
      "id": "wf5-trigger",
