    {
      "id": "wf7-prep",
      "name": "Prep Reminder Queue",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        208
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "try {\n  var apptRows = $('Read Appointment Log').all().map(function(i) { return i.json; });\n  var clientRows = $('Read Clients').all().map(function(i) { return i.json; });\n  var optOutMap = {};\n  clientRows.forEach(function(c) {\n    // D3 BUG-R17 blast radius: an exact string match fails the moment either sheet stores\n    // a phone differently (a coerced number, a stray space). A failed match here means an\n    // opted-out person receives an SMS. Compare digits only.\n    if (c['SMS Opt-Out'] === 'Y') { optOutMap[String(c['Phone'] || '').replace(/[^0-9]/g, '')] = true; }\n  });\n  var now = new Date();\n  var month = now.getUTCMonth() + 1;\n  var tzOffset = (month >= 3 && month <= 10) ? 1 : 0;\n  var nowMs = now.getTime();\n  var queue = [];\n  apptRows.forEach(function(appt) {\n    if (!appt['CalendarEventId'] || !appt['Phone'] || !appt['AppointmentTimeISO']) return;\n    if (appt['Status'] !== 'confirmed') return;\n    // D3 BUG-R10: the live column is 'CancelledAt' with NO space. The spaced version read\n    // undefined, so this guard never fired — masked only by the Status check above it.\n    if (appt['CancelledAt']) return;\n    var apptDigits = String(appt['Phone'] || '').replace(/[^0-9]/g, '');\n    if (apptDigits && optOutMap[apptDigits]) return;\n    var apptMs;\n    try { apptMs = new Date(appt['AppointmentTimeISO']).getTime(); } catch(parseErr) { return; }\n    if (isNaN(apptMs)) return;\n    var diffH = (apptMs - nowMs) / (1000 * 60 * 60);\n    if (diffH < 0) return;\n    if (diffH >= 22 && diffH <= 26 && !appt['Reminder1Sent']) {\n      queue.push({ calendarEventId: appt['CalendarEventId'], phone: appt['Phone'], name: appt['Name'] || 'there', service: appt['Service'] || 'appointment', date: appt['Date'] || '', time: appt['Time'] || '', reminderType: 'R1' });\n    }\n    if (diffH >= 1 && diffH <= 3 && !appt['Reminder2Sent']) {\n      queue.push({ calendarEventId: appt['CalendarEventId'], phone: appt['Phone'], name: appt['Name'] || 'there', service: appt['Service'] || 'appointment', date: appt['Date'] || '', time: appt['Time'] || '', reminderType: 'R2' });\n    }\n  });\n  if (queue.length === 0) { return [{ json: { action: 'none', count: 0 } }]; }\n  return queue.map(function(r) { return { json: r }; });\n} catch(e) { return [{ json: { action: 'error', error: e.message } }]; }"
      },
      "onError": "continueRegularOutput"
    },
