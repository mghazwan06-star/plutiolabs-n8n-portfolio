      "parameters": {
        "jsCode": "var config = $('Client Config').first().json;\nvar lead = $('Parse Lead Data').first().json;\n\nvar payload = {\n  assistantId: config.vapiAssistantId,\n  phoneNumberId: config.vapiPhoneNumberId,\n  customer: { number: lead.phone, name: lead.name },\n  assistantOverrides: { variableValues: { leadName: lead.name, serviceInterest: lead.serviceInterest, leadSource: lead.leadSource } },\n  metadata: { source: 'WF1-lead-intake' }\n};\n\nreturn [{ json: { payload: payload, phone: lead.phone, name: lead.name } }];"
      },
