    {
      "parameters": {
        "jsCode": "var items = $input.all();\nvar body = items[0].json.body || {};\n\nfunction sanitize(str) { return String(str || '').replace(/^[=+\\-@]/, '').trim(); }\n\nvar phone = body.phone || body.Phone || body.phoneNumber || body.phone_number || '';\nvar name = sanitize(body.name || body.Name || body.fullName || body.full_name || '');\nvar email = sanitize(body.email || body.Email || '');\nvar serviceInterest = sanitize(body.serviceInterest || body.service_interest || body.service || body.Service || '');\nvar leadSource = sanitize(body.leadSource || body.lead_source || body.source || body.utm_source || 'Website');\n\nif (phone && phone.charAt(0) === '0') {\n  phone = '+44' + phone.substring(1);\n} else if (phone && phone.charAt(0) !== '+') {\n  phone = '+' + phone;\n}\nphone = phone.replace(/[^+\\d]/g, '');\n\nreturn [{ json: { phone: phone, name: name, email: email, serviceInterest: serviceInterest, leadSource: leadSource, createdAt: new Date().toISOString() } }];"
      },
