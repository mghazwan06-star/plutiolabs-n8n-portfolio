    {
      "id": "d5wf2b-extract-tool",
      "name": "Extract Tool Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        320
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "jsCode": "try {\n  var data = $input.first().json;\n  var msg = data.body.message || {};\n  var call = msg.call || {};\n  var meta = call.metadata || {};\n  var toolCalls = msg.toolCalls || [];\n  var firstTool = toolCalls[0] || {};\n  var toolCallId = firstTool.id || '';\n  var fn = firstTool.function || {};\n  var toolName = fn.name || '';\n  var toolArgs = fn.arguments || {};\n  var phone = (call.customer && call.customer.number) ? call.customer.number : '';\n  var campaignId = meta.campaignId || '';\n  var name = meta.name || '';\n  var attemptCount = parseInt(meta.attemptCount || 0);\n  return [{ json: { phone: phone, campaignId: campaignId, name: name, attemptCount: attemptCount, toolCallId: toolCallId, toolName: toolName, toolArgs: toolArgs } }];\n} catch(e) {\n  return [{ json: { phone: '', campaignId: '', name: '', attemptCount: 0, toolCallId: '', toolName: '', toolArgs: {}, _error: e.message } }];\n}"
      }
    },
