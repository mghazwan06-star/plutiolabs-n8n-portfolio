    {
      "id": "d5wf2b-validate-avail",
      "name": "Validate Response (avail)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1420,
        200
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "jsCode": "try {\n  var response = $input.first().json;\n  var results = response.results;\n  // Valid if: results is array, has at least one item, with non-empty toolCallId and result string\n  if (results && Array.isArray(results) && results.length > 0\n      && results[0].toolCallId && typeof results[0].result === 'string' && results[0].result.length > 0) {\n    return [{ json: response }];\n  }\n  // Sub-workflow crashed or returned malformed data — build graceful fallback\n  var toolCallId = '';\n  try { toolCallId = $('Extract Tool Data').first().json.toolCallId || ''; } catch(e2) {}\n  return [{ json: { results: [{ toolCallId: toolCallId, result: \"I'm having trouble checking availability right now. Let me have our team confirm a time with you directly.\" }] } }];\n} catch(e) {\n  var tid = '';\n  try { tid = $('Extract Tool Data').first().json.toolCallId || ''; } catch(e2) {}\n  return [{ json: { results: [{ toolCallId: tid, result: \"I'm having trouble checking availability right now. Let me have our team confirm a time with you directly.\" }] } }];\n}"
      }
    },
