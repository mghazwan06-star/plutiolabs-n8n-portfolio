    {
      "id": "d5wf2-sticky",
      "name": "D5-WF2 Overview",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -200,
        -80
      ],
      "parameters": {
        "content": "## D5-WF2: Voice Reactivation Engine\n\nScheduled every 30 min (Mon–Sat 09:00–17:00 GMT/BST).\n\nReads Reactivation Log for idle leads (queued + retry-pending + stale call-initiated >2h).\nCross-checks Clients.Status before firing each call (skips booked/DNC/not-interested).\nFires VAPI outbound calls with D5’s own assistant.\n\nUpstream: D5-WF1 writes leads to Reactivation Log.\nDownstream: D5-WF2b routes VAPI events (ID: 1EsyoHL1IaXcyON5, webhook: /webhook/d5-vapi-events).\n\nAll PLACEHOLDER values must be filled before activation.",
        "height": 280,
        "width": 460,
        "color": 6
      }
    },
    {
      "id": "d5wf2-trigger",
      "name": "D5 Voice Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0,30 9-16 * * 1-6"
            }
          ]
        }
      }
    },
