    {
      "id": "d5wf2-filter",
      "name": "Filter & Route",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        200
      ],
      "parameters": {
        "jsCode": "try {\n  var config = $('⚙️ Client Config').first().json;\n  var allReactivation = $('Read Reactivation Log').all().map(function(item) { return item.json; });\n  var allClients = $input.all().map(function(item) { return item.json; });\n\n  var now = new Date();\n  var skipStatuses = ['booked', 'do-not-contact', 'not-interested', 'call-initiated', 'callback-scheduled', 'sequence-active'];\n  var maxAttempts = config.maxVoiceAttempts || 2;\n  var cap = config.maxVoicePerRun || 5;\n\n  var clientsMap = {};\n  allClients.forEach(function(c) {\n    if (c['Phone']) { clientsMap[c['Phone']] = c['Status']; }\n  });\n\n  var results = [];\n\n  for (var i = 0; i < allReactivation.length && results.length < cap; i++) {\n    var row = allReactivation[i];\n    if (!row['Phone'] || row['Pool Type'] !== 'idle') continue;\n\n    var status = row['Reactivation Status'];\n    var action = null;\n\n    if (status === 'queued') {\n      action = 'first-call';\n    } else if (status === 'retry-pending') {\n      var nextTouchAt = row['Next Touch At'] ? new Date(row['Next Touch At']) : null;\n      if (!nextTouchAt || now < nextTouchAt) continue;\n      var attemptCount = parseInt(row['Attempt Count'] || 0);\n      if (attemptCount >= maxAttempts) {\n        action = 'exhausted';\n      } else {\n        action = 'retry-call';\n      }\n    } else if (status === 'call-initiated') {\n      var lastTouch = row['Last Touch'] ? new Date(row['Last Touch']) : null;\n      var staleMs = 2 * 60 * 60 * 1000;\n      if (!lastTouch || (now - lastTouch) <= staleMs) continue;\n      var staleAttempts = parseInt(row['Attempt Count'] || 1);\n      if (staleAttempts >= maxAttempts) {\n        action = 'exhausted';\n      } else {\n        action = 'retry-call';\n      }\n    } else {\n      continue;\n    }\n\n    var phone = row['Phone'];\n    var clientStatus = clientsMap[phone];\n    if (clientStatus && skipStatuses.indexOf(clientStatus) !== -1) {\n      results.push({ json: { phone: phone, campaignId: row['Campaign ID'], name: row['Name'] || '', action: 'completed' } });\n      continue;\n    }\n\n    results.push({ json: {\n      phone: phone,\n      campaignId: row['Campaign ID'],\n      name: row['Name'] || '',\n      email: row['Email'] || '',\n      serviceInterest: row['Service Interest'] || '',\n      reactivationAngle: row['Reactivation Angle'] || 'promo',\n      attemptCount: parseInt(row['Attempt Count'] || 0),\n      action: action\n    } });\n  }\n\n  return results.length > 0 ? results : [{ json: { action: 'none', phone: '', campaignId: '' } }];\n} catch(e) {\n  return [{ json: { action: 'none', phone: '', campaignId: '', _error: e.message } }];\n}"
      },
      "onError": "continueRegularOutput"
    },
