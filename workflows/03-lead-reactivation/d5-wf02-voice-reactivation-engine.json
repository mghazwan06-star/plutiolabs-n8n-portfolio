    {
      "id": "d5wf2-build-payload",
      "name": "Build VAPI Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        0
      ],
      "parameters": {
        "jsCode": "try {\n  var config = $('⚙️ Client Config').first().json;\n  var results = [];\n  $input.all().forEach(function(item) {\n    var lead = item.json;\n    if (!lead.phone) return;\n    var payload = {\n      assistantId: config.d5AssistantId,\n      phoneNumberId: config.d5PhoneNumberId,\n      customer: { number: lead.phone, name: lead.name || '' },\n      assistantOverrides: {\n        variableValues: {\n          customerName: lead.name || 'there',\n          customerPhone: lead.phone,\n          customerEmail: lead.email || '',\n          serviceInterest: lead.serviceInterest || 'Solar Survey',\n          reactivationAngle: lead.reactivationAngle || 'promo',\n          attemptNumber: (lead.attemptCount || 0) + 1\n        },\n        serverUrl: config.d5WebhookUrl\n      },\n      metadata: { campaignId: lead.campaignId, name: lead.name || '', attemptCount: lead.attemptCount || 0, source: 'd5-reactivation' }\n    };\n    results.push({ json: { payload: payload, phone: lead.phone, campaignId: lead.campaignId, name: lead.name || '', attemptCount: lead.attemptCount || 0 } });\n  });\n  return results.length > 0 ? results : [{ json: { _skip: true, payload: null, phone: '', campaignId: '' } }];\n} catch(e) {\n  return [{ json: { _error: e.message, payload: null, phone: '', campaignId: '', name: '', attemptCount: 0 } }];\n}"
      },
      "onError": "continueRegularOutput"
    },
