    {
      "id": "d5book-parse",
      "name": "Parse Booking Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        480
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "jsCode": "try {\n  var input = $('Execute Workflow Trigger').first().json;\n  var toolCallId = input.toolCallId || '';\n  var phone = input.phone || '';\n  var campaignId = input.campaignId || '';\n  var name = input.name || '';\n  var args = input.toolArgs || {};\n  var date = (args.date || '').trim();\n  var time = (args.time || '').trim();\n  var service = (args.service || '').trim();\n  var address = (args.address || '').trim();\n  if (!date || !time || !service || !address) {\n    return [{ json: { toolCallId: toolCallId, phone: phone, campaignId: campaignId, name: name, valid: false, errorMsg: 'To book an appointment I need a date, time, service type and your address. Could you confirm those details?' } }];\n  }\n  var month = new Date().getUTCMonth() + 1;\n  var bst = (month >= 3 && month <= 10) ? 1 : 0;\n  var hour = 9;\n  var timeNorm = time.toLowerCase().replace(/\\s/g, '');\n  var m = timeNorm.match(/^(\\d+)(?::(\\d+))?(am|pm)?$/);\n  if (m) {\n    hour = parseInt(m[1]);\n    if (m[3] === 'pm' && hour !== 12) hour += 12;\n    if (m[3] === 'am' && hour === 12) hour = 0;\n  }\n  var parsed = null;\n  var isoAttempt = new Date(date);\n  if (!isNaN(isoAttempt.getTime())) { parsed = isoAttempt; }\n  if (!parsed) {\n    var monthNames = ['january','february','march','april','may','june','july','august','september','october','november','december'];\n    var dateLower = date.toLowerCase();\n    for (var mi = 0; mi < monthNames.length; mi++) {\n      if (dateLower.indexOf(monthNames[mi]) !== -1) {\n        var numMatch = dateLower.match(/(\\d+)/);\n        if (numMatch) {\n          var dayNum = parseInt(numMatch[1]);\n          var yr = new Date().getUTCFullYear();\n          var candidate = new Date(Date.UTC(yr, mi, dayNum));\n          if (!isNaN(candidate.getTime())) {\n            var todayMidnight = new Date();\n            todayMidnight.setUTCHours(0,0,0,0);\n            if (candidate < todayMidnight) { candidate = new Date(Date.UTC(yr + 1, mi, dayNum)); }\n            parsed = candidate;\n          }\n        }\n        break;\n      }\n    }\n  }\n  if (!parsed || isNaN(parsed.getTime())) {\n    return [{ json: { toolCallId: toolCallId, phone: phone, campaignId: campaignId, name: name, valid: false, errorMsg: \"I couldn't quite get that date. Could you say it like 'the 14th of April' or 'next Tuesday'?\" } }];\n  }\n  var utcH = hour - bst;\n  var startISO = new Date(Date.UTC(parsed.getUTCFullYear(), parsed.getUTCMonth(), parsed.getUTCDate(), utcH, 0, 0)).toISOString();\n  var appointmentTimeISO = startISO;\n  var endISO = new Date(new Date(startISO).getTime() + 3600000).toISOString();\n  return [{ json: { toolCallId: toolCallId, phone: phone, campaignId: campaignId, name: name, date: date, time: time, service: service, address: address, appointmentTimeISO: appointmentTimeISO, startISO: startISO, endISO: endISO, upcomingAppt: date + ' at ' + time, valid: true } }];\n} catch(e) {\n  return [{ json: { toolCallId: ($('Execute Workflow Trigger').first().json.toolCallId||''), phone: ($('Execute Workflow Trigger').first().json.phone||''), campaignId: ($('Execute Workflow Trigger').first().json.campaignId||''), name: ($('Execute Workflow Trigger').first().json.name||''), valid: false, errorMsg: 'I had a problem processing that booking request. Could you repeat the details?' } }];\n}"
      }
    },
