    {
      "id": "d5wf2d-retry-logic",
      "name": "Retry Logic",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1940,
        840
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "jsCode": "try {\n  var cfg = $('⚙️ Client Config').first().json;\n  var data = $input.first().json;\n  var maxAttempts = cfg.maxVoiceAttempts || 2;\n  var retryHours = cfg.retryDelayHours || 24;\n  // WF2 increments Attempt Count on every call-initiated write.\n  // currentAttemptCount=1 means first call already fired. 1<2 → retry. 2<2 → exhausted.\n  var currentAttemptCount = data.currentAttemptCount || 0;\n  var newStatus, nextTouchAt, completedAt;\n  if (currentAttemptCount < maxAttempts) {\n    newStatus = 'retry-pending';\n    nextTouchAt = new Date(Date.now() + retryHours * 60 * 60 * 1000).toISOString();\n    completedAt = '';\n  } else {\n    newStatus = 'exhausted';\n    nextTouchAt = '';\n    completedAt = new Date().toISOString();\n  }\n  return [{ json: { phone: data.phone, campaignId: data.campaignId, newStatus: newStatus, nextTouchAt: nextTouchAt, completedAt: completedAt, transcriptUrl: data.transcriptUrl, callDuration: data.callDuration } }];\n} catch(e) {\n  var d = $input.first().json;\n  return [{ json: { phone: d.phone || '', campaignId: d.campaignId || '', newStatus: 'exhausted', nextTouchAt: '', completedAt: new Date().toISOString(), transcriptUrl: d.transcriptUrl || '', callDuration: d.callDuration || 0 } }];\n}"
      }
    },
