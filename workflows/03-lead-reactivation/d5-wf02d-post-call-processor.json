    {
      "id": "write-to-callback-queue-build",
      "name": "Write to Callback Queue · Build Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2350,
        300
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "jsCode": "try {\n  var hdrResp = $input.first().json || {};\n  var headers = (hdrResp.values && hdrResp.values[0] && hdrResp.values[0].length) ? hdrResp.values[0] : null;\n  var usedFallback = false;\n  if (!headers) { headers = [\"Phone\", \"Name\", \"Service Interest\", \"Callback Preference\", \"Reactivated Via\", \"Reactivated At\", \"Callback Status\", \"Notes\"]; usedFallback = true; }\n  var vals = {\n    \"Phone\": ($('Check Terminal State').first().json.phone),\n    \"Name\": ($('Check Terminal State').first().json.name),\n    \"Service Interest\": ($('Check Terminal State').first().json.serviceInterest),\n    \"Callback Preference\": ($('Check Terminal State').first().json.callbackPreference),\n    \"Reactivated Via\": \"voice\",\n    \"Reactivated At\": (new Date().toISOString()),\n    \"Callback Status\": \"pending\",\n    \"Notes\": \"\"\n  };\n  var row = [];\n  for (var i = 0; i < headers.length; i++) {\n    var h = String(headers[i] || '').trim();\n    row.push(Object.prototype.hasOwnProperty.call(vals, h) ? vals[h] : '');\n  }\n  return [{ json: { row: row, headersVerified: !usedFallback } }];\n} catch(e) { return [{ json: { row: [], headersVerified: false, buildError: e.message } }]; }"
      }
    },
