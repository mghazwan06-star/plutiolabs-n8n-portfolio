    {
      "id": "d5wf2d-terminal-check",
      "name": "Check Terminal State",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        380
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "jsCode": "try {\n  var row = $input.first().json;\n  var extracted = $('Extract Call Result').first().json;\n  // exhausted and completed added — stale EOC events for these leads should only update transcript\n  var terminalStatuses = ['booked', 'opted-out', 'interested-callback', 'declined-final', 'exhausted', 'completed'];\n  var currentStatus = row['Reactivation Status'] || '';\n  var isTerminal = terminalStatuses.indexOf(currentStatus) !== -1;\n  var currentAttemptCount = parseInt(row['Attempt Count'] || extracted.attemptCount || 0);\n  var serviceInterest = row['Service Interest'] || extracted.serviceInterest || '';\n  return [{ json: { alreadyTerminal: isTerminal, currentStatus: currentStatus, currentAttemptCount: currentAttemptCount, serviceInterest: serviceInterest, phone: extracted.phone, campaignId: extracted.campaignId, name: extracted.name, interestLevel: extracted.interestLevel, callbackPreference: extracted.callbackPreference, transcriptUrl: extracted.transcriptUrl, callDuration: extracted.callDuration } }];\n} catch(e) {\n  var ex = $('Extract Call Result').first().json;\n  return [{ json: { alreadyTerminal: false, currentStatus: '', currentAttemptCount: ex.attemptCount || 0, serviceInterest: ex.serviceInterest || '', phone: ex.phone, campaignId: ex.campaignId, name: ex.name, interestLevel: ex.interestLevel, callbackPreference: ex.callbackPreference, transcriptUrl: ex.transcriptUrl, callDuration: ex.callDuration } }];\n}"
      }
