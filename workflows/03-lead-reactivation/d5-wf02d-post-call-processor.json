    {
      "id": "d5wf2d-extract",
      "name": "Extract Call Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        480
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "jsCode": "try {\n  var body = $input.first().json.body || $input.first().json;\n  var msg = body.message || {};\n  var call = msg.call || {};\n  var analysis = msg.analysis || {};\n  var structured = analysis.structuredData || {};\n  var phone = (call.customer && call.customer.number) ? call.customer.number : '';\n  var meta = call.metadata || {};\n  var campaignId = meta.campaignId || '';\n  var name = meta.name || '';\n  var attemptCount = parseInt(meta.attemptCount || 0);\n  var callId = call.id || '';\n  var interestLevel = structured.interest_level || 'no-answer';\n  var callbackPreference = structured.callback_preference || '';\n  var transcriptUrl = msg.recordingUrl || msg.stereoRecordingUrl || '';\n  var callDuration = Math.round(parseFloat(msg.durationSeconds || 0));\n  var serviceInterest = meta.serviceInterest || '';\n  return [{ json: { phone: phone, campaignId: campaignId, name: name, attemptCount: attemptCount, callId: callId, interestLevel: interestLevel, callbackPreference: callbackPreference, transcriptUrl: transcriptUrl, callDuration: callDuration, serviceInterest: serviceInterest } }];\n} catch(e) {\n  return [{ json: { phone: '', campaignId: '', name: '', attemptCount: 0, callId: '', interestLevel: 'no-answer', callbackPreference: '', transcriptUrl: '', callDuration: 0, serviceInterest: '', _error: e.message } }];\n}"
      }
    },
